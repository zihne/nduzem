<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="OpaqueShare"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!--
                Universal-link intent-filter claims three path prefixes
                under https://<host>/ so tapping any of these email or
                share links opens the app when installed, falling back
                to the corresponding branded web page otherwise:

                  /r/*             — in-app link-mode receive
                                     (client ADR-0010, fallback:
                                     server-rendered web decrypt page
                                     per server ADR-0035)
                  /password-reset  — in-app "choose new password" form
                                     (fallback: infra/www/password-reset.html)
                  /verify-email    — in-app auto-verify screen
                                     (fallback: infra/www/verify-email.html)

                All three prefixes go into a SINGLE intent-filter so
                autoVerify treats them as one App Links host claim —
                Android verifies the assetlinks.json once per host,
                not per prefix.

                OPERATOR TODO: replace `opaqueshare.com` with the real
                deployment host, and deploy a matching
                .well-known/assetlinks.json at that host containing this
                app's release SHA-256 signing fingerprints (upload key
                AND Play App Signing key — both are needed). Without
                both, android:autoVerify="true" fails silently and the
                OS shows a chooser instead of routing straight to the
                app. See ADR-0010 for the operator setup steps.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
                <data android:host="opaqueshare.com"/>
                <data android:pathPrefix="/r/"/>
                <data android:pathPrefix="/password-reset"/>
                <data android:pathPrefix="/verify-email"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin.

         The otpauth:// entry lets url_launcher find the user's
         authenticator app for MFA enrolment — Android 11+ requires
         explicit visibility for custom schemes. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="otpauth"/>
        </intent>
    </queries>
</manifest>
